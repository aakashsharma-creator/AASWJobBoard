    .multiselect-wrapper {
      position: relative;
      width: 100%;
    }

    .multiselect-trigger {
      width: 100%;
      height: 48px;
      padding: 0 18px 0 18px !important;
      font-size: 14px;
      border: 2px solid #e2e8f0;
      border-radius: 8px;
