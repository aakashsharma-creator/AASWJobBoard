// Resend OTP
add_action('wp_ajax_nopriv_resend_otp', 'resend_otp');
add_action('wp_ajax_resend_otp', 'resend_otp');

function resend_otp()
{
    $email = isset($_POST['email']) ? sanitize_email($_POST['email']) : '';
    if (empty($email))
        wp_send_json_error(['message' => 'Invalid request.']);

    $user = get_user_by('email', $email);
    if (!$user)
        wp_send_json_error(['message' => 'No user found.']);

    $temp_data = get_user_meta($user->ID, '_temp_login_data', true);
    if (!$temp_data)
        wp_send_json_error(['message' => 'Session expired. Please login again.']);

    $otp = rand(100000, 999999);
    update_user_meta($user->ID, '_login_otp', $otp);
    update_user_meta($user->ID, '_login_otp_expiration', time() + 300); // 5 min expiry
    update_user_meta($user->ID, '_login_attempts', 0);

    send_otp_email($user->user_email, $otp);

    wp_send_json_success(['message' => 'New OTP sent to your email.']);
}

// Verify OTP
add_action('wp_ajax_nopriv_verify_otp', 'verify_otp');
add_action('wp_ajax_verify_otp', 'verify_otp');

function verify_otp()
{
    $email = isset($_POST['email']) ? sanitize_email($_POST['email']) : '';
    $otp = isset($_POST['otp']) ? intval($_POST['otp']) : 0;

    if (empty($email) || empty($otp))
        wp_send_json_error(['message' => 'Please enter the OTP.']);

    $user = get_user_by('email', $email);
    if (!$user)
        wp_send_json_error(['message' => 'No user found.']);

    $stored_otp = get_user_meta($user->ID, '_login_otp', true);
    $expiration = get_user_meta($user->ID, '_login_otp_expiration', true);
    $attempts = (int) get_user_meta($user->ID, '_login_attempts', true);

    if (!$stored_otp || !$expiration || time() > $expiration) {
        wp_send_json_error(['message' => 'OTP expired. Please login again.']);
    }

    if ($stored_otp != $otp) {
        $attempts++;
        update_user_meta($user->ID, '_login_attempts', $attempts);
        $attempts_left = max(0, 5 - $attempts);
        wp_send_json_error(['message' => 'Invalid OTP. Attempts left: ' . $attempts_left]);
    }

    $temp_data = get_user_meta($user->ID, '_temp_login_data', true);
    if (!$temp_data)
        wp_send_json_error(['message' => 'Session expired. Please login again.']);

    // Set auth cookie
    wp_set_current_user($user->ID);
    wp_set_auth_cookie($user->ID, $temp_data['remember']);

    // Clean up user meta
    delete_user_meta($user->ID, '_login_otp');
    delete_user_meta($user->ID, '_login_otp_expiration');
    delete_user_meta($user->ID, '_temp_login_data');
    delete_user_meta($user->ID, '_login_attempts');

    $redirect = $temp_data['role'] === 'employer' ? home_url('/employer-dashboard/') : home_url('/locum-dashboard/');

    wp_send_json_success(['redirect' => $redirect, 'message' => 'Login successful!']);
}
