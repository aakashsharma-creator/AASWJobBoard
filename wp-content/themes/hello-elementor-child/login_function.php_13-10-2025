function custom_ajax_login()
{
    $username = isset($_POST['username']) ? sanitize_text_field($_POST['username']) : '';
    $password = isset($_POST['password']) ? wp_unslash($_POST['password']) : '';
    $remember = (!empty($_POST['remember']) && $_POST['remember'] === 'forever');
    $selected_tab_role = isset($_POST['role']) ? sanitize_text_field($_POST['role']) : '';

    if (empty($username) || empty($password)) {
        wp_send_json_error(['message' => 'Please enter both email and password.']);
    }

    $creds = [
        'user_login' => $username,
        'user_password' => $password,
        'remember' => $remember
    ];

    $user = wp_signon($creds, is_ssl());

    if (is_wp_error($user)) {
        $raw_message = strip_tags($user->get_error_message());
        $clean_message = stripos($raw_message, 'Invalid username') !== false ?
            'No account found with this email address.' :
            (stripos($raw_message, 'incorrect password') !== false ?
                'Incorrect password. Please try again.' : 'Login failed. Please check your credentials.');
        wp_send_json_error(['message' => $clean_message]);
    }

    // Check user role
    $roles = $user->roles;
    $expected_role = ($selected_tab_role === 'locum') ? 'candidate' : $selected_tab_role;
    if (!in_array($expected_role, $roles)) {
        wp_clear_auth_cookie();
        wp_logout();
        wp_send_json_error(['message' => 'Your account role does not match the selected login type.']);
    }

    // Generate OTP
    $otp = rand(100000, 999999);

    // Store OTP, attempts, and temp login data in user meta
    update_user_meta($user->ID, '_login_otp', $otp);
    update_user_meta($user->ID, '_login_otp_expiration', time() + 300); // 5 min expiry
    update_user_meta($user->ID, '_temp_login_data', [
        'remember' => $remember,
        'role' => $expected_role
    ]);
    update_user_meta($user->ID, '_login_attempts', 0);

    // Send OTP email
    send_otp_email($user->user_email, $otp);

    wp_logout();

    wp_send_json_success([
        'message' => 'Please enter the OTP sent to your email.',
        'otp_required' => true,
        'email' => $username
    ]);
}

